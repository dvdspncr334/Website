rules_version = '2';

// JGV3D Firestore security rules.
//
// Only the signed-in owner can read or write their own cart at
// users/{uid}/carts/current. The owner can also read/write their saved
// shipping address (users/{uid}/profile/shipping) and create/read their own
// orders (users/{uid}/orders/{orderId}). Guest checkout uses Firebase
// Anonymous Authentication: an anonymous user owns users/{anonUid}/orders
// exactly like an account, must mark the order `guest: true` with a valid
// contact email, and cannot save a shipping address. Admins (users with an admins/{uid}
// document) can update order status/cancellation metadata and delete orders,
// read every order and saved address, manage the admins list and read/delete
// userActivity. Everything else is denied by default.
//
// If your project already has rules for other data, MERGE the
// `match` blocks (carts, profile/shipping, orders, admins, userActivity) and
// the helper functions into
// your existing rules instead of replacing them (see FIREBASE_SETUP.md).
service cloud.firestore {
  match /databases/{database}/documents {

    // The first admin is added by hand in the Firebase Console (console
    // writes bypass these rules); after that, admins add/remove admins.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isCartOwner(uid, cartId) {
      return request.auth != null && request.auth.uid == uid && cartId == 'current';
    }

    function isValidItem(item) {
      return item is map
        && item.keys().hasAll(['id', 'title', 'price', 'img', 'qty'])
        && item.keys().hasOnly(['id', 'title', 'price', 'img', 'qty'])
        && item.id is string && item.id.size() >= 1 && item.id.size() <= 300
        && item.title is string && item.title.size() >= 1 && item.title.size() <= 300
        && item.img is string && item.img.size() <= 500
        && (item.img.matches('https?://.*') || !item.img.matches('.*:.*'))
        && (item.price is int || item.price is float)
        && item.price >= 0 && item.price <= 100000
        && item.qty is int && item.qty >= 1 && item.qty <= 99;
    }

    // Each write either removes items only, or adds/updates exactly the one
    // item named by `lastKey` (which must be valid).
    function isValidCartWrite(before) {
      let data = request.resource.data;
      let changes = data.items.diff(before);
      return data.keys().hasAll(['items', 'lastKey', 'schema', 'updatedAt'])
        && data.keys().hasOnly(['items', 'lastKey', 'schema', 'updatedAt'])
        && data.schema == 1
        && data.updatedAt == request.time
        && data.items is map
        && data.items.size() <= 50
        && data.lastKey is string
        && data.lastKey.matches('k[0-9a-f]{64}')
        && (
          (changes.addedKeys().size() == 0 && changes.changedKeys().size() == 0)
          || (changes.affectedKeys().hasOnly([data.lastKey])
              && data.lastKey in data.items
              && isValidItem(data.items[data.lastKey]))
        );
    }

    match /users/{uid}/carts/{cartId} {
      allow read: if isCartOwner(uid, cartId);
      allow create: if isCartOwner(uid, cartId) && isValidCartWrite({});
      allow update: if isCartOwner(uid, cartId)
        && resource.data.items is map
        && isValidCartWrite(resource.data.items);
      allow delete: if isCartOwner(uid, cartId);
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isText(value, minSize, maxSize) {
      return value is string && value.size() >= minSize && value.size() <= maxSize;
    }

    // Every field is a string; optional fields may be empty.
    function isValidAddress(a) {
      return a is map
        && a.keys().hasAll(['firstName', 'lastName', 'streetAddress1', 'streetAddress2', 'city',
                            'state', 'postalCode', 'country', 'phone', 'deliveryNotes'])
        && isText(a.firstName, 1, 80)
        && isText(a.lastName, 1, 80)
        && isText(a.streetAddress1, 1, 120)
        && isText(a.streetAddress2, 0, 120)
        && isText(a.city, 1, 80)
        && isText(a.state, 1, 80)
        && isText(a.postalCode, 1, 20)
        && isText(a.country, 1, 60)
        && isText(a.phone, 0, 40)
        && isText(a.deliveryNotes, 0, 500);
    }

    // Guest checkout signs buyers in with Firebase Anonymous Authentication.
    function isAnonymousUser() {
      return request.auth != null
        && request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'anonymous';
    }

    // Kept in sync with isValidContactEmail() in account-data.js.
    function isValidContactEmail(value) {
      return isText(value, 6, 254)
        && value.matches('[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+[.][A-Za-z]{2,}');
    }

    // Signed-in accounts: email must be the account email and there is no
    // guest marker. Anonymous guests: guest == true and a valid contact email.
    function isValidOrderContact(data) {
      return isAnonymousUser()
        ? (data.get('guest', false) == true && isValidContactEmail(data.email))
        : (!data.keys().hasAny(['guest']) && data.email == request.auth.token.get('email', ''));
    }

    function isValidOrder(orderId, data) {
      return data.keys().hasAll(['id', 'date', 'createdAt', 'status', 'items', 'total', 'shipping', 'notes', 'email'])
        && data.keys().hasOnly(['id', 'date', 'createdAt', 'status', 'items', 'total', 'shipping', 'notes', 'email', 'guest'])
        && data.id == orderId
        && orderId.matches('JGV-[0-9]{8}')
        && isText(data.date, 10, 40)
        && data.createdAt == request.time
        && data.status == 'In Queue'
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 50
        && (data.total is int || data.total is float)
        && data.total >= 0 && data.total <= 5000000
        && data.shipping is map
        && data.shipping.keys().hasOnly(['firstName', 'lastName', 'streetAddress1', 'streetAddress2', 'city',
                                         'state', 'postalCode', 'country', 'phone', 'deliveryNotes'])
        && isValidAddress(data.shipping)
        && isText(data.notes, 0, 1000)
        && isValidOrderContact(data);
    }

    // One saved shipping address per user.
    match /users/{uid}/profile/shipping {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) && !isAnonymousUser()
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'streetAddress1', 'streetAddress2', 'city',
                                                 'state', 'postalCode', 'country', 'phone', 'deliveryNotes', 'lastUpdated'])
        && isValidAddress(request.resource.data)
        && request.resource.data.lastUpdated == request.time;
      allow delete: if isOwner(uid);
    }

    function isValidAdminOrderUpdate() {
      let data = request.resource.data;
      return data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'cancellationReason', 'statusUpdatedAt', 'statusUpdatedBy'])
        && data.keys().hasAll(['status', 'cancellationReason', 'statusUpdatedAt', 'statusUpdatedBy'])
        && data.status in ['In Queue', 'In Progress', 'Shipped', 'Completed', 'Cancelled']
        && isText(data.cancellationReason, 0, 500)
        && (data.status == 'Cancelled' || data.cancellationReason == '')
        && data.statusUpdatedBy == request.auth.uid
        && data.statusUpdatedAt == request.time;
    }

    // Mutations apply only to this exact canonical order path, including legacy orders.
    match /users/{uid}/orders/{orderId} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && isValidOrder(orderId, request.resource.data);
      allow update: if isAdmin() && isValidAdminOrderUpdate();
      allow delete: if isAdmin();
    }

    // Lets admins list every user's orders with a collection-group query.
    match /{path=**}/orders/{orderId} {
      allow read: if isAdmin();
    }

    // Admin list. Users may read only their own admin document (to learn
    // whether they are an admin); admins may list, add and remove admins.
    // A new admin must be a known user (has signed in, so userActivity/{uid}
    // exists) and the stored email must match that record.
    match /admins/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin()
        && uid.size() >= 1 && uid.size() <= 128
        && request.resource.data.keys().hasAll(['email', 'addedBy', 'addedAt'])
        && request.resource.data.keys().hasOnly(['email', 'addedBy', 'addedAt'])
        && exists(/databases/$(database)/documents/userActivity/$(uid))
        && request.resource.data.email == get(/databases/$(database)/documents/userActivity/$(uid)).data.email
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.addedAt == request.time;
      allow delete: if isAdmin();
    }

    // Minimal sign-in activity, written by each signed-in user for
    // themselves only and readable only by admins.
    match /userActivity/{uid} {
      allow read: if isAdmin();
      allow delete: if isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['email', 'lastSignInAt', 'lastActiveAt'])
        && request.resource.data.keys().hasOnly(['email', 'lastSignInAt', 'lastActiveAt'])
        && request.auth.token.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.lastSignInAt is timestamp
        && request.resource.data.lastSignInAt <= request.time
        && request.resource.data.lastActiveAt == request.time;
    }
  }
}
